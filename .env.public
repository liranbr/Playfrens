DOMAIN=localhost
BACKEND_PORT=3000
# Selfsign as HTTPS for both Vite and Backend. 
# Remember to re-run "npm run dev" when changing.
# Only in development! This is disabled in Production!
SELF_SIGN_HTTPS=true

# The app's public URL. Override in production with your real domain without the port.
BASE_URL=https://localhost:5174

# Set to false to redirect straight to the DB's avatar URL instead of proxying (see backend/routes/auth.js).
# Why? Because curiosity killed the RAM, the avatar cache grows unbounded (see TODO in auth.js).
AVATAR_PROXY_ENABLED=true