# Sample template showing what the ".env" file should look like.
# ⚠️ Do NOT commit your real .env file to Git! ⚠️
# Each contributor must generate or securely receive the necessary API keys.

#################################
# SteamGridDB API Key
#################################
# 1) Log in via Steam at: https://www.steamgriddb.com/
# 2) Go to Preferences > API
# 3) Generate your API key and paste it below.
STEAMGRIDDB_API_KEY=your-steamgriddb-key-here

#################################
# Steam Web API Key
#################################
# 1) Create a Steam account (if you don't have one).
# 2) Go to: https://steamcommunity.com/dev/apikey
# 3) For the domain field, use "localhost" for development purposes.
# 4) Generate your API key and paste it below.
STEAM_WEB_API_KEY=your-steamweb-key-here

#################################
# Google OAuth2.0
#################################
# 1) TO-DO
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

#################################
# Discord OAuth2.0
#################################
# 1) Go to: https://discord.com/developers/applications
# 2) Create a new application (or select an existing one) > OAuth2.
# 3) Copy the Client ID and Client Secret and paste them below.
DISCORD_CLIENT_ID=your-discord-client-id-here
DISCORD_CLIENT_SECRET=your-discord-client-secret-here

#################################
# Supabase Configuration
#################################
# 1) Go to your Supabase dashboard > Project Settings > API.
# 2) Copy the Project URL (starts with "https://...supabase.co").
# 3) Copy your Publishable Key and Secret Key.
# 4) Paste them below.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key-here
SUPABASE_SECRET_KEY=sb_secret_your-server-key-here

#################################
# Internal Sync Secret
#################################
# Shared secret for the Render Cron Job that hits /sync and /enrichTypes 
# See ./backend/routes/steamCatalog.js 
# Generate one the same way as SESSION_SECRET below.
INTERNAL_SYNC_SECRET=your-internal-sync-secret-here

#################################
# Session Secret
#################################
# A 32-Bit long string used by express for session ID cookies.
# To generate one, run this command: 
# 1) node -e "console.log('Session Secret created, paste it into your .env file! =>', require('crypto').randomBytes(24).toString('base64').slice(0,32))"
# 2) Paste the result below.
# 3) For most optimal security please call this command every month and replace it down below.
SESSION_SECRET=your-session-secret-here